{
  "name": "podcast-rss-migrater",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted podcast archiver and RSS feed migrater. Downloads a show from its feed, converts artwork to JPEG, rewrites every asset URL to a new host, and delivers the result as a ZIP or over SFTP.",
  "license": "MIT",
  "author": "Tyler Woodward",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "fast-xml-parser": "^5.11.1",
    "sharp": "^0.34.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.9.0",
    "@types/ssh2": "^1.15.0",
    "eslint": "^9.14.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.12.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
