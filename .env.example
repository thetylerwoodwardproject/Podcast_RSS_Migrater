# Podcast RSS Migrater configuration.
# Every value below is optional -- the app runs correctly with no configuration at all.
# Copy to .env (or /etc/migrater/migrater.env for native installs) and edit as needed.

# Port the server binds to (read by the Node adapter).
PORT=8080

# Where job workspaces are written. Each job gets a directory under this path and
# holds a full copy of the podcast, so this needs room for the shows you migrate.
MIGRATER_DATA_PATH=./data

# Prefills the "new base URL" field in the UI, e.g. https://media.example.com/
MIGRATER_DEFAULT_BASE_URL=

# JPEG quality used when converting artwork, 1-100.
MIGRATER_JPEG_QUALITY=90

# How many jobs may run at once, and how many assets each downloads in parallel.
MIGRATER_MAX_CONCURRENT_JOBS=1
MIGRATER_MAX_CONCURRENT_DOWNLOADS=4

# Refuse any single asset larger than this, and abandon a job whose total exceeds this.
MIGRATER_MAX_ASSET_MB=1000
MIGRATER_MAX_JOB_GB=50

# Per-request timeout for downloads, in milliseconds.
MIGRATER_DOWNLOAD_TIMEOUT_MS=60000

# Job workspaces older than this are deleted by the cleanup sweep.
MIGRATER_JOB_RETENTION_HOURS=24

# Allow the server to fetch from private, loopback and link-local addresses.
# Leave false unless you are deliberately migrating a feed on your own network.
MIGRATER_ALLOW_PRIVATE_HOSTS=false

# Trust X-Forwarded-* headers. Enable only behind a reverse proxy you control.
MIGRATER_TRUST_PROXY=false

# Log level: debug, info, warn, error.
MIGRATER_LOG_LEVEL=info

# Optional SFTP defaults that prefill the Publish panel. Never put a password or
# private key here -- credentials are entered in the UI and are never written to disk.
MIGRATER_SFTP_HOST=
MIGRATER_SFTP_PORT=22
MIGRATER_SFTP_USERNAME=
MIGRATER_SFTP_REMOTE_PATH=/
